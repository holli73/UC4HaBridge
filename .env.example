# Copy to .env and fill in. .env is git-ignored and never leaves this machine.
AE_URL=https://automic.example.local:8088/ae/api/v1
AE_CLIENT=100
# Token auth header value, e.g. "Bearer xxxxx" (or "Basic base64(client/user/dept:password)")
AE_AUTH=Bearer CHANGE_ME
AE_VERIFY_TLS=true

# VARA object names
AE_VARA_ACTUAL=VARA.HEATING.ACTUAL
AE_VARA_TARGET=VARA.HEATING.TARGET
AE_VARA_MODE=VARA.HEATING.MODE
AE_VARA_WEEKDAY=VARA.HEATING.WEEKDAY
AE_VARA_WEEKEND=VARA.HEATING.WEEKEND

# Dummy test room key
AE_TEST_ROOM=ClaudeRoom
